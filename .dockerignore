# Keep the build context small and reproducible.
# Submodules are re-cloned inside the image if empty, so it's fine
# to ship an empty vendor/vSim; but if the host has it populated,
# we copy it through (it's ~small).

.git
.github
.venv
venv
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Rust build artifacts (we rebuild binaries inside container if asked)
experiments/rust_features/rust_crate/target
experiments/rust_features/rust_crate/Cargo.lock

# Backup copies of binaries
experiments/rust_features/*.bak

# Editor / OS
.vscode
.idea
.DS_Store
*.swp
*.swo

# Memory / local claude state
.claude

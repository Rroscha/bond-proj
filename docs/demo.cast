[67.305397, "o", "\r\n$ python3 -c \"\r\nimport json\r\nd = json.load(open('/tmp/rustdiff-demo/analysis_data.json'))\r\nfor p, fn in d['features'].items():\r\n    row = f'{fn:<28}'\r\n    for m in d['methods']:\r\n        mm = d['summary'][p]['methods'][m]\r\n        row += f'  {m}: R={mm[\\\"rust_accuracy\\\"]:4.0%} C={mm[\\\"c_accuracy\\\"]:4.0%}'\r\n    print(row)\r\n\"\r\n"]
[68.325156, "o", "Ownership & Move              value: R=  4% C= 24%  opcodes: R=  6% C= 36%  constants: R=  2% C= 51%  size: R=  0% C= 20%\r\nDrop Glue (RAII)              value: R= 12% C= 37%  opcodes: R=  4% C= 39%  constants: R= 10% C= 57%  size: R=  2% C= 28%\r\nBounds Checking               value: R= 12% C= 25%  opcodes: R= 33% C= 50%  constants: R=  4% C= 62%  size: R= 12% C= 38%\r\n? Operator (Option/Result)    value: R= 11% C= 60%  opcodes: R= 33% C= 36%  constants: R= 11% C= 36%  size: R=  8% C= 28%\r\nPanic/Unwind Paths            value: R=  6% C= 60%  opcodes: R= 12% C= 67%  constants: R=  6% C= 87%  size: R=  3% C= 47%\r\n"]
